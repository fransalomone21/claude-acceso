-// a name the level's AI gun sounds have: the weapon's own, else one of the same ammo pool, else any
+// how unlike the weapon a stand-in sounds: its fire type first, then its fire interval and its clip (BLACK (135): with
+// "any", a pistol the level's enemies don't carry was heard as a shotgun)
+float Unlike(uint32_t d, uint32_t data) {
+    auto rel = [](float a, float b) {
+        float m = std::fmax(std::fabs(a), std::fabs(b));
+        return m > 0 && std::isfinite(a) && std::isfinite(b) ? std::fabs(a - b) / m : 1.0f;
+    };
+    float u = R32(d + kDataFireType) == R32(data + kDataFireType) ? 0.0f : 4.0f;
+    if (R32(d + kDataAmmo) != R32(data + kDataAmmo)) u += 2.0f;
+    u += rel(G<float>(d + kDataHold), G<float>(data + kDataHold));
+    u += rel(float(R16(d + kDataClip)), float(R16(data + kDataClip)));
+    return u;
+}
