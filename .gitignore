# Los informes contienen datos de tu telefono (apps instaladas, serial, cuentas).
# Se quedan en tu maquina y no se suben al repositorio.
informes/*
!informes/.gitkeep
*.zip

# --- proyecto black ---
# Volcados de memoria y sesiones de escaneo: archivos de 32 MB que no tiene
# sentido versionar. Si un volcado concreto importa para documentar un
# hallazgo, forzalo con `git add -f` y explica en la bitacora por que.
black/volcados/*
!black/volcados/.gitkeep
black/construido/*
!black/construido/.gitkeep
*.p2s
*.ee.bin

# --- perfil-global/pilares ---
# Texto crudo extraido de los PDF de los libros (PyMuPDF). Son cientos de
# miles de chars, se regeneran con un comando, y el PDF no es nuestro.
# Lo que se versiona es la ficha destilada, no la fuente.
perfil-global/pilares/_*.txt

__pycache__/
*.pyc
