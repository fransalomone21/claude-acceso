#!/bin/sh
# post-commit -- publica en Drive el apunte que este commit acaba de tocar.
#
# Por que un hook de git y no "acordarse": el PDF del apunte esta trackeado,
# asi que el commit es el momento EXACTO en que el apunte cambio de verdad.
# Cualquier otro disparador (cerrar sesion, una tarea programada, pedirselo a
# alguien) o llega tarde o depende de que alguien se acuerde.
#
# Corre solo si el commit toco un apunte. Un commit de codigo no paga la
# latencia de red.
#
# Fuente versionada: .claude/hooks/post-commit
# Instalado en    : .git/hooks/post-commit  (no se versiona, por eso hay copia)
# Que esta instalado lo MIDE publicar-apuntes.ps1 -Verificar en cada arranque.

raiz=$(git rev-parse --show-toplevel)

# QUE CUENTA COMO "UN APUNTE" LO DICE LA LISTA, NO EL NOMBRE DEL ARCHIVO.
# Hasta el 2026-09-29 esto miraba solo 'apunte/apunte.pdf', y cuatro PDFs
# declarados y trackeados (la hoja de formulas y los dos parciales de Fisica
# Espacial, la guia de IDEs) cambiaban sin que nada los subiera. Regla de
# Fran: lo publico se sube ni bien cambia. Se mantiene el patron viejo como
# segunda condicion: un apunte.pdf SIN declarar dispara igual, y el
# publicador lo reporta como 'sin declarar' en vez de callarlo.
# $1 y PUBLICAR_SOLO_DECIDIR son costuras de prueba: git llama al hook sin
# argumentos, asi que en uso real es HEAD y publica.
rev=${1:-HEAD}
declarados=$(sed -n 's/.*"local": *"\([^"]*\)".*/\1/p' "$raiz/.claude/apuntes-publicos.json")
toco=no
for f in $(git diff-tree --no-commit-id --name-only -r "$rev"); do
    if printf '%s\n' "$declarados" | grep -qxF "$f"; then toco=si; fi
    case "$f" in */apunte/apunte.pdf|apunte/apunte.pdf) toco=si ;; esac
done

if [ -n "$PUBLICAR_SOLO_DECIDIR" ]; then echo "toco=$toco"; exit 0; fi
if [ "$toco" = no ]; then
    exit 0
fi

echo ""
echo "[post-commit] este commit toco un apunte -- publicando en Drive"

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$raiz\publicar-apuntes.ps1" < /dev/null

# El exit code no se propaga a proposito: git ignora el del post-commit, y un
# Drive caido no tiene que parecer un commit fallido. Si la subida fallo, el
# medidor del proximo arranque lo dice igual.
exit 0
